# ─── Clerk Authentication ─────────────────────────────────────
# Get your publishable key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=

# ─── Supabase (optional — mock data used when disabled) ──────
# Set to "true" to switch from mock/faker data to real Supabase tables
VITE_USE_SUPABASE=true 
VITE_SUPABASE_URL=https://mmkxmrtmtlvngpolnxse.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ooUn6-_fYpMTUt2GVeFk6g_Kt7Rxogc
# Get your project URL and anon key from Supabase dashboard > Settings > API
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── OpenAI (optional — mock responses used when disabled) ───
# Set to "true" to enable real AI responses from OpenAI
VITE_USE_OPENAI=false
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# ─── Deployment ──────────────────────────────────────────────
# Used for canonical URLs, SEO meta tags, and CSP headers
VITE_APP_URL=http://localhost:5173

# ─── Error Tracking (optional) ──────────────────────────────
# Sentry DSN for production error tracking
VITE_SENTRY_DSN=

# ─── Product Analytics (optional) ───────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
